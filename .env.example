# -----------------------------------------------------------------------------
# HireShield AI — Zero-Cost Serverless & Native Configuration Template
# -----------------------------------------------------------------------------

# Neon Serverless Postgres
# Pooled URL for application queries (PgBouncer port 6543 / -pooler)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-orange-poetry-atp7ecbu-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct URL for Prisma CLI schema migrations (Direct connection port 5432)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-orange-poetry-atp7ecbu.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Express Backend (Local / Render)
PORT=4000
NODE_ENV="development"
JWT_SECRET="replace-with-a-secure-random-32-character-secret"
CORS_ORIGIN="http://localhost:3000"

# AI Microservice Connection (Local: http://127.0.0.1:8000 | Remote: Render/Koyeb)
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_SECRET="local-dev-service-secret-2026"

# Python FastAPI & Google Gemini API (Free Tier from Google AI Studio)
GEMINI_API_KEY="AIzaSy...YourKeyFromGoogleAIStudio"

# Upstash Redis (Optional Free Tier Rate Limiting)
UPSTASH_REDIS_REST_URL="https://YOUR_CLUSTER.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_TOKEN"

# Next.js Frontend (Local / Vercel)
NEXT_PUBLIC_API_URL="http://localhost:4000"
